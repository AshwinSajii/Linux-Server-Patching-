#!/bin/bash
set -euo pipefail

# ===== Base Paths =====
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$BASE_DIR/lib"

# ===== Logging =====
LOG_DIR="/var/log/patchmgr"
mkdir -p "$LOG_DIR"
export LOG_DIR

# ===== Version =====
VERSION="2.0.0"

# ===== Colors =====
GREEN="\e[32m"
RED="\e[31m"
YELLOW="\e[33m"
BLUE="\e[34m"
NC="\e[0m"

success() { echo -e "${GREEN}$1${NC}"; }
error()   { echo -e "${RED}$1${NC}"; }
warn()    { echo -e "${YELLOW}$1${NC}"; }
info()    { echo -e "${BLUE}$1${NC}"; }
#!/bin/bash
set -euo pipefail

# ===== Base Paths =====
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$BASE_DIR/lib"

# ===== Logging =====
LOG_DIR="/var/log/patchmgr"
mkdir -p "$LOG_DIR"
export LOG_DIR

# ===== Version =====
VERSION="2.1.0"

# ===== Colors =====
GREEN="\e[32m"
RED="\e[31m"
YELLOW="\e[33m"
BLUE="\e[34m"
NC="\e[0m"

success() { echo -e "${GREEN}$1${NC}"; }
error()   { echo -e "${RED}$1${NC}"; }
warn()    { echo -e "${YELLOW}$1${NC}"; }
info()    { echo -e "${BLUE}$1${NC}"; }

# ===== Root Check =====
if [[ $EUID -ne 0 ]]; then
  error "Please run as root or use sudo."
  exit 1
fi

# ===== Argument Parsing =====
DRY_RUN=false
AUTO_YES=false

COMMAND="${1:-}"
shift || true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=true
      ;;
    -y|--yes)
      AUTO_YES=true
      ;;
    *)
      error "Unknown option: $1"
      exit 1
      ;;
  esac
  shift
done

# ===== Help =====
show_help() {
  echo "PatchMgr v$VERSION"
  echo
  echo "Usage:"
  echo "  patchmgr precheck"
  echo "  patchmgr apply [-y] [--dry-run]"
  echo "  patchmgr postcheck"
  echo "  patchmgr report"
  echo "  patchmgr full [-y] [--dry-run]"
  echo
}

# ===== Confirmation Prompt =====
confirm_action() {
  if [[ "$AUTO_YES" == true ]]; then
    return
  fi

  read -p "Are you sure you want to continue? (y/N): " choice
  case "$choice" in
    y|Y ) ;;
    * ) warn "Operation cancelled."; exit 0 ;;
  esac
}

# ===== Reboot Detection =====
check_reboot() {
  if [[ -f /var/run/reboot-required ]]; then
    warn "System reboot is required!"
    if [[ "$AUTO_YES" == true ]]; then
      warn "Rebooting automatically..."
      reboot
    else
      read -p "Reboot now? (y/N): " reboot_choice
      if [[ "$reboot_choice" =~ ^[Yy]$ ]]; then
        reboot
      else
        warn "Reboot skipped."
      fi
    fi
  else
    success "No reboot required."
  fi
}

# ===== Command Handler =====
case "$COMMAND" in

  precheck)
    info "Running Precheck..."
    source "$LIB_DIR/precheck.sh"
    success "Precheck completed."
    ;;

  apply)
    confirm_action

    if [[ "$DRY_RUN" == true ]]; then
      warn "DRY RUN MODE - No changes will be made."
      apt list --upgradable
      exit 0
    fi

    info "Applying patches..."
    source "$LIB_DIR/patching.sh"
    success "Patch apply completed."
    check_reboot
    ;;

  postcheck)
    info "Running Postcheck..."
    source "$LIB_DIR/postcheck.sh"
    success "Postcheck completed."
    ;;

  report)
    info "Generating Report..."
    source "$LIB_DIR/report.sh"
    success "Report generated."
    ;;

  full)
    confirm_action

    if [[ "$DRY_RUN" == true ]]; then
      warn "DRY RUN MODE - Simulating full cycle."
      source "$LIB_DIR/precheck.sh"
      apt list --upgradable
      exit 0
    fi

    info "Starting Full Patch Cycle..."

    source "$LIB_DIR/precheck.sh"
    source "$LIB_DIR/patching.sh"
    check_reboot
    source "$LIB_DIR/postcheck.sh"
    source "$LIB_DIR/report.sh"

    success "Full patch cycle completed successfully."
    ;;

  version)
    echo "PatchMgr Version $VERSION"
    ;;

  help|-h|--help|"")
    show_help
    ;;

  *)
    error "Invalid command."
    show_help
    exit 1
    ;;

esac
